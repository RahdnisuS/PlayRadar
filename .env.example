# Copy to .env.local and fill in. Every service here has a free tier.

# Supabase (Project Settings -> API, and -> Database -> Connection string, session pooler)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Only for the Supabase CLI (functions deploy)
SUPABASE_ACCESS_TOKEN=

# Groq (console.groq.com -> API Keys)
GROQ_API_KEY=

# IGDB via Twitch (dev.twitch.tv -> Your Console -> Applications)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# IsThereAnyDeal (isthereanydeal.com -> Apps)
ITAD_API_KEY=

# YouTube Data API v3 (Google Cloud console -> Credentials -> API key)
YOUTUBE_API_KEY=

# Brevo: API key (xkeysib-...) for alert emails; SMTP key (xsmtpsib-...) + login for Supabase auth emails
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=PlayRadar

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random strings you generate yourself (e.g. `openssl rand -base64 32`)
GUEST_TOKEN_SECRET=
# Same value must be set as a secret on the Supabase "embed" edge function
EMBED_SECRET=

# Comma-separated emails allowed on /admin/videos
ADMIN_EMAILS=
